# Optional: copy to .env. Provider/model are snapshotted when each job is queued.
PHOTO_AGENT_DATA_DIR=./data
PHOTO_AGENT_PROVIDER=demo
# Set a vision + structured-output capable model when using a real provider.
PHOTO_AGENT_MODEL=demo-v1
# PHOTO_AGENT_PROVIDER=typesafe
# PHOTO_AGENT_MODEL=jev-1.14.0
# TYPESAFE_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# PHOTO_AGENT_OLLAMA_URL=http://localhost:11434
# PHOTO_AGENT_TYPESAFE_IMAGES_ENABLED=true

# Video routing and preparation (native transport currently requires OpenRouter).
PHOTO_AGENT_VIDEO_MODE=auto
PHOTO_AGENT_MODEL_SUPPORTS_VIDEO=false
PHOTO_AGENT_VIDEO_FRAME_COUNT=8
PHOTO_AGENT_VIDEO_MAX_SIDE=768
PHOTO_AGENT_VIDEO_START_SECONDS=0
PHOTO_AGENT_VIDEO_MAX_SECONDS=30
PHOTO_AGENT_VIDEO_FPS=4
PHOTO_AGENT_VIDEO_MAX_BYTES=20971520
PHOTO_AGENT_MAX_VIDEO_UPLOAD_BYTES=262144000
